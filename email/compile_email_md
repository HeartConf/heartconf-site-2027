#!/usr/bin/env python3
import os
import subprocess
import sys
import tempfile
from pathlib import Path


def extract_content_div(html: str) -> str:
    start = html.find('<div id="content"')
    if start == -1:
        raise RuntimeError('could not find <div id="content"> in compiled output')

    open_end = html.find('>', start)
    if open_end == -1:
        raise RuntimeError('malformed <div id="content"> tag')

    depth = 1
    pos = open_end + 1
    while depth > 0:
        nxt_open = html.find('<div', pos)
        nxt_close = html.find('</div>', pos)
        if nxt_close == -1:
            raise RuntimeError('unbalanced <div> tags in compiled output')
        if nxt_open != -1 and nxt_open < nxt_close:
            depth += 1
            pos = html.find('>', nxt_open) + 1
        else:
            depth -= 1
            pos = nxt_close + len('</div>')

    return html[start:pos]


def main() -> None:
    if len(sys.argv) != 2:
        print(f'Usage: {sys.argv[0]} <markdown-file.md>', file=sys.stderr)
        sys.exit(1)

    md_path = Path(sys.argv[1]).resolve()
    if not md_path.is_file():
        print(f'No such file: {md_path}', file=sys.stderr)
        sys.exit(1)

    script_dir = Path(__file__).resolve().parent
    template_path = script_dir / 'template.heml'
    if not template_path.is_file():
        print(f'Missing template: {template_path}', file=sys.stderr)
        sys.exit(1)

    out_path = md_path.with_suffix('.html')

    content = subprocess.run(
        ['pandoc', str(md_path), '-f', 'markdown', '-t', 'html'],
        check=True,
        capture_output=True,
        text=True,
    ).stdout

    heml = template_path.read_text().replace('{{ template "content" . }}', content)

    fd, tmp_name = tempfile.mkstemp(suffix='.heml')
    os.close(fd)
    tmp_heml = Path(tmp_name)
    tmp_html = tmp_heml.with_suffix('.html')
    try:
        tmp_heml.write_text(heml)
        subprocess.run(
            [str(script_dir / 'custom_heml'), 'build', str(tmp_heml)],
            check=True,
            cwd=script_dir,
        )
        out_path.write_text(extract_content_div(tmp_html.read_text()))
    finally:
        tmp_heml.unlink(missing_ok=True)
        tmp_html.unlink(missing_ok=True)

    print(f'Wrote {out_path}')


if __name__ == '__main__':
    main()
